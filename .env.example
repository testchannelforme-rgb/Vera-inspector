# Local development stays restricted; public mode is started with --isolated.
VEYRA_NETWORK_MODE=restricted
VEYRA_ALLOWED_HOSTS=example.com,www.example.com
VEYRA_BIND_HOST=127.0.0.1
# Optional exact frontend origin if a trusted reverse proxy rewrites Host.
# VEYRA_UI_ORIGIN=https://your-exact-private-host
# Do not set public browser/control/proxy secrets here. Compose manages them.

# V0.3 optional AI. Leave disabled for a zero-cost local generator.
# Set credentials using Codespaces secrets or an ignored .env file; never commit them.
VEYRA_AI_ENABLED=false
VEYRA_AI_PROVIDER=openai-compatible
VEYRA_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
VEYRA_AI_MODEL=
VEYRA_AI_API_KEY=
VEYRA_AI_TIMEOUT_SECONDS=15
VEYRA_AI_MAX_OUTPUT_TOKENS=1500
VEYRA_AI_TOKEN_PARAMETER=max_completion_tokens

# V0.4: trusted operator configuration; keep the forwarded port private.
VEYRA_PORT=8001
VEYRA_OPERATOR_PLAN=free
VEYRA_FREE_GENERATIONS_PER_DAY=4
VEYRA_FREE_REFINEMENTS_PER_DAY=2
VEYRA_FREE_PREVIEWS_PER_DAY=4
VEYRA_PREMIUM_GENERATIONS_PER_DAY=50
VEYRA_PREMIUM_REFINEMENTS_PER_DAY=50
VEYRA_PREMIUM_PREVIEWS_PER_DAY=100
# PREVIEWS_PER_DAY reserves a future hosted-preview allowance. Local compilation
# and editor rendering are deliberately unmetered; they never call an AI model.
VEYRA_USAGE_DB=.veyra-runtime/studio.sqlite3
# Existing VEYRA_AI_* settings configure prompt generation. These tasks inherit
# them unless overridden; use separate models/providers/keys as needed.
VEYRA_CODE_AI_ENABLED=false
VEYRA_CODE_AI_MODEL=
VEYRA_CODE_AI_API_KEY=
VEYRA_CODE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
VEYRA_REFINE_AI_ENABLED=false
VEYRA_REFINE_AI_MODEL=
VEYRA_REFINE_AI_API_KEY=
VEYRA_REFINE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
