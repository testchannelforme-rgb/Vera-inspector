# The app does not load .env automatically. Export this in your terminal if needed.
# Comma-separated exact hosts; every CDN and redirect host also needs review.
VEYRA_ALLOWED_HOSTS=example.com,www.example.com
# Default loopback is suitable for Codespaces port forwarding. For a private LAN
# development host only, opt into 0.0.0.0; never expose this unauthenticated prototype.
VEYRA_BIND_HOST=127.0.0.1

# Usually automatic in Codespaces. For a trusted reverse proxy that rewrites Host,
# set its exact browser-facing origin (no trailing slash). Never use a wildcard.
# VEYRA_UI_ORIGIN=https://your-exact-private-host
