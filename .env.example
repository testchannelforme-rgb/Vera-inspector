# Local development stays restricted; public mode is started with --isolated.
VEYRA_NETWORK_MODE=restricted
VEYRA_ALLOWED_HOSTS=example.com,www.example.com
VEYRA_BIND_HOST=127.0.0.1
# Optional exact frontend origin if a trusted reverse proxy rewrites Host.
# VEYRA_UI_ORIGIN=https://your-exact-private-host
# Do not set public browser/control/proxy secrets here. Compose manages them.

# V0.3 optional AI. Leave disabled for a zero-cost local generator.
# Set credentials using Codespaces secrets or an ignored .env file; never commit them.
VEYRA_AI_ENABLED=false
VEYRA_AI_PROVIDER=openai-compatible
VEYRA_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
VEYRA_AI_MODEL=
VEYRA_AI_API_KEY=
VEYRA_AI_TIMEOUT_SECONDS=15
VEYRA_AI_MAX_OUTPUT_TOKENS=1500
VEYRA_AI_TOKEN_PARAMETER=max_completion_tokens
