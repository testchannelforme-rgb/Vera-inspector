{
  "name": "Veyra AI V0.4 Code Studio",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerUser": "node",
  "remoteUser": "node",
  "init": true,
  "runArgs": [
    "--security-opt",
    "seccomp=${localWorkspaceFolder}/.devcontainer/seccomp_profile.json",
    "--shm-size=512m"
  ],
  "forwardPorts": [
    8001
  ],
  "portsAttributes": {
    "8001": {
      "label": "Veyra AI V0.4",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/doctor.sh --environment-only",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
