{
  "name": "Veyra Inspector",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {"ghcr.io/devcontainers/features/node:1": {"version": "22"}},
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "init": true,
  "runArgs": ["--security-opt", "seccomp=${localWorkspaceFolder}/.devcontainer/seccomp_profile.json", "--shm-size=512m", "--memory=2g", "--cpus=2"],
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Veyra Inspector", "onAutoForward": "notify", "visibility": "private"}},
  "postCreateCommand": "bash scripts/setup.sh --system-deps",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
